{
  "name": "eng-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generic, introspection-driven admin UI for any Postgres database. Browse and (optionally) edit your real tables — built on TanStack Start + shadcn/ui.",
  "author": "Hubble Ventures",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubble-ventures/eng-ops.git"
  },
  "homepage": "https://github.com/hubble-ventures/eng-ops#readme",
  "bugs": {
    "url": "https://github.com/hubble-ventures/eng-ops/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "admin",
    "database",
    "tanstack-start",
    "shadcn",
    "crud",
    "introspection"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/seed.sql",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@refinedev/core": "^5.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swmansion/argent": "^0.22.1",
    "@tanstack/react-query-devtools": "^5.102.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
