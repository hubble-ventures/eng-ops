# Connection string for the Postgres database you want to administer.
# Use a read-only role for safety if you only need browsing.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Optional: comma-separated schema allowlist to introspect.
# Unset/empty => all non-system schemas in the database.
# PGSCHEMA=public,app

# Optional TLS mode (libpq-style). Unset => defer to the connection string's
# own `sslmode` (fine for local, unencrypted databases). Set this for managed
# hosts (Neon, RDS, Supabase) that require TLS:
#   disable | require | no-verify | verify-ca | verify-full
#   - require / no-verify : encrypt but do not verify the server certificate
#   - verify-ca / verify-full : verify (optionally against PGSSLROOTCERT)
# PGSSLMODE=require
# PGSSLROOTCERT=/path/to/server-ca.pem

# Optional path to a JSON config file (default: ./engops.config.json).
# See engops.config.example.json for the shape.
# ENGOPS_CONFIG=engops.config.json

# Optional global column-ordering strategy; overrides the config file default.
#   natural => the database's own column order (default)
#   smart   => primary key, name-like columns, and foreign keys first;
#              audit timestamps last
# ENGOPS_COLUMN_ORDER=smart

# Enable create/update/delete. OFF by default — eng-ops is a read-only browser
# unless this is set, and the DB role must actually have write privileges.
# Accepts "1" or "true".
# ENGOPS_WRITE=1
